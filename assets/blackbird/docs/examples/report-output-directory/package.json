{
  "schemaVersion": 2,
  "type": "action",
  "version": "1.0.0",
  "description": "Read-only shared-setting tutorial.",
  "tags": [
    "utilities"
  ],
  "dependencies": [
    "example-settings"
  ],
  "libraryCompatibility": {
    "requires": {
      "example-settings": "settings-1"
    },
    "provides": []
  },
  "action": {
    "requiresProject": true,
    "requiresDevice": false
  },
  "entrypoints": {
    "windows": {
      "runner": "powershell",
      "path": "run.ps1"
    }
  },
  "id": "report-output-directory",
  "label": "Report Output Directory",
  "settings": {
    "inputs": [
      {
        "definition": "example.outputDirectory",
        "owner": "example-settings",
        "revision": 1,
        "required": true
      }
    ]
  }
}
