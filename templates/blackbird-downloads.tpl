<div class="download-controls">
  <p class="download-intro">{{t:download.blackbird.status}}</p>
  <div class="download-platforms">
    <div class="download-option" role="group" aria-label="{{t:download.blackbird.windows.group}}">
      <p class="download-platform">{{t:download.blackbird.windows.platform}}</p>
      <p class="download-requirements">{{t:download.blackbird.windows.requirements}}</p>
      <a class="button primary" data-blackbird-download="exe" data-build-download="blackbird_windows_exe" href="#">{{t:download.blackbird.windows}}</a>
      <a class="installer-alternative" data-blackbird-download="msi" data-build-download="blackbird_windows_msi" href="#">{{t:download.blackbird.msi}}</a>
      <p class="download-note">{{t:download.blackbird.choice}}</p>
    </div>
    <div class="download-option download-option-pending" role="group" aria-label="{{t:download.blackbird.macos.group}}">
      <p class="download-platform">{{t:download.blackbird.macos.platform}}</p>
      <p class="download-requirements">{{t:download.blackbird.macos.requirements}}</p>
      <p class="download-availability">{{t:download.blackbird.macos.status}}</p>
      <p class="download-format">{{t:download.blackbird.macos.format}}</p>
      <p class="download-note">{{t:download.blackbird.macos.note}}</p>
    </div>
  </div>
</div>
